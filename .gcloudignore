# Upload only what the Docker build needs: package manifests, tsconfig, src/.
# Everything else — installs, bundles, docs, the Codex plugin — stays local.
.git/
node_modules/
dist/
*.mcpb
tests/
docs/
codex-plugin/
.agents/
.claude/
.github/
icon.png
logo.svg
*.md
.env*
.mcpbignore
.npmignore
vitest.config.ts
# The production OAuth verifier. It is a developer tool run from a laptop
# against the deployed services — the Dockerfile never COPYs it, so this only
# keeps it out of the build context.
verify-oauth.mjs
