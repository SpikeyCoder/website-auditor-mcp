# Website Auditor MCP — configuration
# Copy to `.env` and fill in. NEVER commit the real .env (see .gitignore).

# Base URL of the Website Auditor API portal (the SpikeyCoder/website-auditor-api service).
# This is the service the MCP wraps. Default is the public production host.
WA_API_BASE_URL=https://api.website-auditor.io

# Base URL of the Website Auditor site (used to build shareable report URLs).
WA_SITE_URL=https://website-auditor.io

# Per-user API key minted from a Website Auditor Pro account (starts with "wa_").
# STDIO INSTALLS ONLY. The hosted HTTP entry (dist/http.js) discards this: there
# the key arrives per request in an `Authorization: Bearer` or `X-API-Key`
# header (see WA_HTTP_DEFAULT_KEY below for the single-tenant exception).
# Set this in the MCP client's server config. There is no free API tier — every
# tool except get_sample_audit requires the key's account to hold an active
# subscription. The key is read once at startup, so restart your MCP client
# after changing it.
# A value that is still an unexpanded client placeholder — "${WA_API_KEY}",
# "${env:WA_API_KEY}", "$WA_API_KEY" — is treated as UNSET rather than as a
# malformed key: clients that interpolate config (Cursor plugin variables)
# forward their own syntax verbatim when the user set nothing.
WA_API_KEY=

# Where callers are sent to upgrade / subscribe. Surfaced in auth + quota errors.
WA_UPGRADE_URL=https://api.website-auditor.io/admin_portal/

# Request timeout (ms) for calls to the API portal.
WA_REQUEST_TIMEOUT_MS=120000

# Audit cache TTL (ms). A domain audited within this window is reused instead of
# spending a fresh audit against the daily quota (used by compare_competitors).
# Defaults to 24h, mirroring the upstream engine's AI-visibility cache.
WA_AUDIT_CACHE_TTL_MS=86400000

# Subscription tier cache TTL (ms). The Pro/free tier is resolved from the live
# GET /api/subscription endpoint and cached per key for this window so it isn't a
# round-trip on every tool call. Short by default (60s) so upgrades/downgrades
# reflect quickly.
WA_SUBSCRIPTION_CACHE_TTL_MS=60000

# EXPLICIT local-dev tier override — NOT the default path. Tier is normally read
# from the live subscription endpoint. Set to "pro" or "free" only to exercise a
# tier locally without a real subscription. Ignored when WA_API_KEY is unset.
WA_DEV_TIER=

# P0 success-metric telemetry. The server emits fire-and-forget session_init and
# tool_call events to the API portal's /api/mcp-events endpoint (never blocks a
# tool call). Set to 1/true to disable emission entirely. See README →
# "Telemetry & success metrics".
WA_METRICS_DISABLED=

# How auth/upgrade errors and instructions talk about the paid plan.
#   link (default) — carry the sign-up/portal link (WA_UPGRADE_URL).
#   info           — for deployments under marketplace rules that forbid
#                    checkout links (the OpenAI plugin directory): price and
#                    trial terms are still stated, but every link — including
#                    ones the API returns — points at WA_UPSELL_INFO_URL.
WA_UPSELL_STYLE=
# The informational page "info" style links to. Defaults to WA_SITE_URL.
WA_UPSELL_INFO_URL=

# Hosted Streamable HTTP entry point (dist/http.js) — not used by stdio installs.
# Port to listen on (also honors PORT; default 8787).
WA_HTTP_PORT=
# Domain-verification token for the OpenAI plugin submission, served verbatim at
# /.well-known/openai-apps-challenge. Unset ⇒ the route 404s.
# Same placeholder rule as WA_API_KEY: a value still holding unexpanded template
# syntax counts as unset, so a template that failed to interpolate 404s rather
# than serving the literal "${...}" with a 200 — which would make the verifier
# report a token MISMATCH and send you hunting a wrong value.
WA_APPS_CHALLENGE_TOKEN=

# Pin the anonymous telemetry install id (a v4 UUID). For hosted deployments on
# ephemeral filesystems, where each instance would otherwise mint its own id and
# inflate install counts. Local installs should leave this unset.
WA_INSTALL_ID=

# SINGLE-TENANT HTTP DEPLOYMENTS ONLY (demo instances, personal self-hosting):
# credential-less requests act as this key instead of the anonymous surface.
# Never set this on the public multi-tenant endpoint.
# Same placeholder rule as WA_API_KEY above: a value still holding unexpanded
# template syntax is treated as UNSET, so a compose file that failed to
# interpolate leaves anonymous callers on the sample surface instead of making
# every one of them act as a tenant named "${WA_HTTP_DEFAULT_KEY}" and be told
# "Invalid API key format".
# "Credential-less" INCLUDES a request whose own Bearer token is an unexpanded
# placeholder: on a box with this set, such a caller acts as this key. Same rule
# ("a placeholder is the absence of a credential") applied to the request side,
# and another reason this must never be set on a shared endpoint.
WA_HTTP_DEFAULT_KEY=

# Browser origins allowed to READ responses cross-origin. Only meaningful
# alongside WA_HTTP_DEFAULT_KEY. Comma-separated, exact origins:
#   WA_HTTP_ALLOWED_ORIGINS=https://ops.example,https://status.example
# Without a default key the endpoint answers `Access-Control-Allow-Origin: *`,
# which is safe because it lends no identity: a browser page gets the keyless
# surface exactly like curl, and has to present its own key to be anybody.
# WITH a default key, credential-less requests are somebody, so `*` would let
# any page the operator happens to visit drive this box as that account and read
# the results — the server supplying a credential to a caller who asked for
# nothing. So a default key withholds the header, and this is how you opt
# specific origins back in. Non-browser clients (curl, every MCP client) ignore
# CORS entirely, so leaving this unset restricts nothing real.
WA_HTTP_ALLOWED_ORIGINS=

# ─── Mixed Auth (hosted HTTP only) ─────────────────────────────────────────
# OAuth 2.1 for the ChatGPT listing. The OpenAI portal offers No Auth / Mixed
# Auth / OAuth and NO api-key mode, so a listing where most tools need a
# subscriber account has to speak OAuth — under No Auth every Pro tool answers
# AUTH_REQUIRED to every user, which is what got the app rejected on 2026-08-24.
#
# BOTH of the next two must be set before ANY OAuth surface appears. Set neither
# (the default, and every stdio install) and this server behaves exactly as it
# did before OAuth existed: no metadata document, no securitySchemes, no
# challenge, and `Authorization: Bearer wa_…` still means the key itself.
# Half-setting them is treated as unset rather than published as a document that
# fails discovery at the client.
#
# The authorization server users are sent to.
WA_OAUTH_ISSUER=
# This server's own canonical resource identifier — the URL clients actually
# POST to. The RFC 9728 metadata document is served at the ORIGIN of this value
# (/.well-known/oauth-protected-resource), so it is not configured separately.
WA_OAUTH_RESOURCE_URL=
# The single scope protected tools request. One scope, not a read/write split:
# ChatGPT and the MCP authorization spec disagree about mid-session scope
# escalation, so a tool that discovers it needs a second scope cannot reliably
# ask for one. Defaults to "audit".
WA_OAUTH_SCOPE=
# Every scope this resource's authorization requests use, space-delimited, for
# the RFC 9728 document's `scopes_supported`. A SUPERSET of WA_OAUTH_SCOPE:
# that one is the audit capability a tool needs, while ChatGPT also requests the
# identity scopes alongside it, and reads this list to learn it may.
#
# Defaults to WA_OAUTH_SCOPE alone, so leaving it unset changes nothing. Set it
# to "audit openid email" only when the authorization server actually offers
# those — this server cannot see the AS's capabilities, and advertising a scope
# the AS will reject turns every login into an invalid_scope error.
WA_OAUTH_SCOPES=
# Where an access token is exchanged for the account's API key (RFC 7662).
# Defaults to ${WA_API_BASE_URL}/api/oauth/introspect.
WA_OAUTH_INTROSPECTION_URL=
# How THIS server authenticates to that endpoint. Required in production: an
# unauthenticated introspection endpoint is a token oracle for anyone who can
# reach it.
WA_OAUTH_INTROSPECTION_SECRET=
